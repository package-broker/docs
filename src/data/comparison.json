    {
      "id": "satis",
      "name": "Satis",
      "sourceUrl": "https://github.com/composer/satis",
      "migration": {
        "href": "/docs/migration/from-satis",
        "published": true
      },
      "fit": {
        "value": "Choose Satis when static Composer files are enough and you already protect them on your web server. To keep client outputs separate, build and protect a separate output for each client. You do not need a running registry application for that setup.",
        "sourceUrl": "https://raw.githubusercontent.com/composer/satis/main/README.md",
        "lastVerified": "2026-10-17",
        "verified": true,
        "quote": "A simple static Composer repository generator."
      }
    },
    {
      "id": "private-packagist",
      "name": "Private Packagist",
      "sourceUrl": "https://packagist.com/docs",
      "migration": {
        "href": "/docs/migration/from-private-packagist",
        "published": true
      },
      "fit": {
        "value": "Choose Private Packagist Cloud when you would rather pay for a hosted Composer service than operate your agency\u2019s registry. Its pricing counts users and suborganizations.",
        "sourceUrl": "https://packagist.com/pricing",
        "lastVerified": "2026-10-17",
        "verified": true,
        "quote": "First 3 users and 3 suborganizations included"
      }
    },
    {
      "id": "packeton",
      "name": "Packeton",
      "sourceUrl": "https://docs.packeton.org/",
      "migration": {
        "href": "/docs/migration/from-packeton",
        "published": true
      },
      "fit": {
        "value": "Choose Packeton when your agency needs a self-hosted PHP package repository, prefers the MIT licence and wants its documented Docker deployment.",
        "sourceUrl": "https://raw.githubusercontent.com/vtsykun/packeton/master/README.md",
        "lastVerified": "2026-10-17",
        "verified": true,
        "quote": "Run as Docker container"
      }
    }
  ],
