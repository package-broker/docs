{
  "name": "@package-broker/site",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": { "node": ">=24" },
  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": ["last 3 chrome version", "last 3 firefox version", "last 5 safari version"]
  },
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build && node scripts/curate-llms.mjs build && node scripts/check-seo.mjs build && node scripts/check-llms.mjs build && node scripts/og/check.mjs build --require-png",
    "test": "node --test scripts/*.test.* tests/*.test.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "docusaurus-plugin-llms": "0.6.1",
    "lucide-react": "1.61.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
}
